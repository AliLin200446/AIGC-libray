# Live AI Analyze — server-side only. Obtain your own NVIDIA NIM key.
NVIDIA_API_KEY=

# Core Framefield needs no credentials. Experimental Reference Analysis needs:
# Server-only, set in Vercel Project > Settings > Environment Variables > Production.
# Never use VITE_ prefixes or put real values in source control.
OPENAI_API_KEY=
# Optional server configuration; existing model/prompt remain unchanged.
OPENAI_REFERENCE_MODEL=gpt-5.4-mini
OPENAI_REFERENCE_TIMEOUT_MS=60000
# Optional loopback production-preview port (npm start).
PORT=5175

# Cinematic ingestion: server-side only. Never prefix these with VITE_.
# Leave unset for the fully local mock workflow.
PEXELS_API_KEY=
# OPENAI_API_KEY is shared with the existing reference analyzer above.
# Choose an image-capable Responses API model available to your project.
OPENAI_CLIP_MODEL=

# Optional film metadata discovery only; never needed for local review.
# Server-side YouTube Data API key and comma-separated, independently verified channel IDs.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_IDS=

# TMDB movie/cover metadata. Server-only Read Access Token (Bearer), not VITE_*.
TMDB_API_READ_ACCESS_TOKEN=
# Copy an approved logo URL from TMDB branding (image.tmdb.org only).
# Required before an explicitly authorized external cover preview; not a rights grant.
TMDB_ATTRIBUTION_LOGO_URL=
