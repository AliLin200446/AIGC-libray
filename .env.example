# Core public Framefield: NO environment variables or credentials required.
# Vercel publishes dist only. Reference Analysis is disabled in production.
# Optional LOCAL DEVELOPMENT / human-authorized evaluation only, server-side:
# Never prefix these variables with VITE_. Never put credentials in Vercel for this static release.
OPENAI_API_KEY=
OPENAI_REFERENCE_MODEL=gpt-5.4-mini
OPENAI_REFERENCE_TIMEOUT_MS=60000
# Optional local production-output preview (npm start), loopback only:
PORT=5175
