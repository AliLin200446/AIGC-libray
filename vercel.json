{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/library",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/clips",
      "destination": "/explore",
      "permanent": false
    },
    {
      "source": "/clips/:id([^/.]+)",
      "destination": "/explore/:id",
      "permanent": false
    },
    {
      "source": "/playground",
      "destination": "/compose",
      "permanent": false
    },
    {
      "source": "/about",
      "destination": "/index",
      "permanent": false
    },
    {
      "source": "/recipes",
      "destination": "/compose?presets=1",
      "permanent": false
    },
    {
      "source": "/recipes/:slug",
      "destination": "/compose?recipe=:slug",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://image.tmdb.org https://i.ytimg.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/reference-analysis.mjs": {
      "maxDuration": 90,
      "supportsCancellation": true
    },
    "api/analyze.mjs": {
      "maxDuration": 120
    }
  },
  "git": {
    "deploymentEnabled": false
  }
}
